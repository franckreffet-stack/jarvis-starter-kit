# ==============================================================================
# .env.example — Template public des variables d'environnement
#
# Copier ce fichier en ".env" et renseigner les vraies valeurs dedans.
# Ce fichier ne contient et ne doit jamais contenir de vraies clés.
# ==============================================================================

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Notion ---
NOTION_API_KEY=

# --- Google (Cloud / Workspace) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=

# --- YouTube (Data API) ---
YOUTUBE_API_KEY=

# --- Vercel ---
VERCEL_TOKEN=

# --- GitHub ---
GITHUB_TOKEN=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
